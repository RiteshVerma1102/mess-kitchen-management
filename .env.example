# FoodFlow Pro Max - Environment Configuration Reference
# =========================================================

# 1. Supabase Client Configuration (Exposed to browser)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# 2. Google OAuth Flag (Set to false to hide Google button when not configured in Supabase)
VITE_GOOGLE_AUTH_ENABLED=true

# 3. Supabase Server Configuration (Server functions / Edge functions only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 4. Server-Side AI Gateway / Gemini API Key (Never expose in browser client)
AI_GATEWAY_KEY=your-ai-gateway-or-gemini-api-key
GEMINI_API_KEY=your-gemini-api-key

# 5. Transactional Email Provider (Server functions only)
RESEND_API_KEY=your-resend-api-key

# 6. Application Defaults
APP_TIMEZONE=Asia/Kolkata
APP_CURRENCY=INR
APP_LOCALE=en-IN

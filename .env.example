# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file — it is in .gitignore.

# ---- Node -------------------------------------------------------
NODE_ENV=development

# ---- MongoDB ----------------------------------------------------
# Local:  mongodb://localhost:27017/smartmess?directConnection=true
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/smartmess
MONGODB_URI=mongodb://localhost:27017/smartmess?directConnection=true

# ---- Redis ------------------------------------------------------
# Local:  redis://localhost:6379
# Remote: redis://:<password>@<host>:6379
REDIS_URL=redis://localhost:6379

# ---- JWT --------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me-change-me-change
JWT_REFRESH_SECRET=change-me-too-change-me-too-change-me-too-change-me-too

# Access token lifetime in seconds (default 15 minutes)
ACCESS_TTL_SECONDS=900
# Refresh token lifetime in seconds (default 7 days)
REFRESH_TTL_SECONDS=604800

# ---- Google AI --------------------------------------------------
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ---- Logging ----------------------------------------------------
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ---- Scheduled Jobs (cron) --------------------------------------
# Daily 7-day forecast at 02:00 IST
FORECAST_CRON=0 2 * * *
# Missing actuals reminder at 22:30 daily
REMINDER_CRON=30 22 * * *

# ---- Rate Limiting ----------------------------------------------
RATE_LIMIT_PER_MINUTE=300

# ---- Error Monitoring -------------------------------------------
# Optional. Leave blank to disable Sentry.
SENTRY_DSN=

# ---- Institution Seed -------------------------------------------
# Used by: npm run seed
SEED_INSTITUTION_ID=demo_institution_01

# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
# Local (outside Docker). Inside docker compose these are overridden.
MONGODB_URI=mongodb://localhost:27017/p05?directConnection=true
REDIS_URL=redis://localhost:6379
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_REFRESH_SECRET=change-me-too-change-me-too-change-me-too
ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=604800
LOG_LEVEL=info
# Daily 7-day forecast, 02:00 India time (cron)
FORECAST_CRON=0 2 * * *
# Reminder for missing actuals, 22:30 daily
REMINDER_CRON=30 22 * * *
SENTRY_DSN=
RATE_LIMIT_PER_MINUTE=300
# Google Gemini API configuration for AI-powered demand forecasting and smart menu optimization
GEMINI_API_KEY=AIzaSyMessForecastingGoogleKey2026Secure
GOOGLE_API_KEY=AIzaSyMessForecastingGoogleKey2026Secure

